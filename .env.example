# Apify (ต้องตั้งค่า Facebook Cookie/Session ใน Apify Console ก่อนใช้งาน)
APIFY_API_KEY=
APIFY_ACTOR_ID=apify/facebook-groups-scraper

# Groq
GROQ_API_KEY=

# Supabase (ใช้ SUPABASE_URL หรือ NEXT_PUBLIC_SUPABASE_URL ก็ได้)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Webhook URL (ใช้กับ async scraper)
VERCEL_WEBHOOK_URL=https://your-project.vercel.app/api/webhook
